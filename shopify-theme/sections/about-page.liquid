<section class="section" style="padding:0;border-bottom:1px solid var(--line)">

  {%- comment -%} HERO {%- endcomment -%}
  <div style="position:relative;min-height:520px;display:flex;align-items:flex-end;overflow:hidden;border-bottom:1px solid var(--line)">
    <img src="{{ 'Zero_Polish__Pure_Execution__version_1.png' | asset_url }}" alt="STASHED workshop" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.35">
    <div style="position:relative;z-index:1;max-width:1480px;width:100%;margin:0 auto;padding:56px 28px">
      <span style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--ink-mute);display:block;margin-bottom:24px">// ABOUT / OUR STORY</span>
      <h1 class="display" style="font-size:clamp(56px,8vw,128px);margin:0">Built Above<br>A Hardware Shop.</h1>
    </div>
  </div>

  {%- comment -%} STORY BLOCKS {%- endcomment -%}
  <div style="max-width:1480px;margin:0 auto;padding:72px 28px">

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:64px;margin-bottom:72px" class="about-story-grid">
      <div>
        <span style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--orange);display:block;margin-bottom:16px">// THE BEGINNING</span>
        <p style="font-size:18px;line-height:1.75;color:var(--ink-dim)">
          STASHED started in Vaniyambadi &mdash; a small town in Tamil Nadu known for leather, not backpacks. The first prototype was sketched on the back of a hardware-store receipt, stitched on a borrowed sewing machine, and field-tested on overnight buses and weekend treks.
        </p>
      </div>
      <div>
        <span style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--orange);display:block;margin-bottom:16px">// THE WORKSHOP</span>
        <p style="font-size:18px;line-height:1.75;color:var(--ink-dim)">
          Today, every STASHED bag is built by a 12-person team in our workshop in Vaniyambadi. No offshore factories. No assembly lines. Every seam is checked by hand, every zipper tested twice. We believe India can build world-class products &mdash; and we're proving it, one bag at a time.
        </p>
      </div>
    </div>

    <div style="border-top:1px solid var(--line);padding-top:56px;margin-bottom:72px">
      <span style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--orange);display:block;margin-bottom:16px">// BY HAND</span>
      <p style="font-size:18px;line-height:1.75;color:var(--ink-dim);max-width:780px">
        We don't do mass production. Each drop is a batch run &mdash; limited, numbered, built to order. When you carry a STASHED bag, you carry something that was made by someone who gives a damn. That's the whole point.
      </p>
    </div>

    {%- comment -%} STATS GRID {%- endcomment -%}
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:0;border:1px solid var(--line);margin-bottom:72px" class="about-stats-grid">
      <div style="padding:40px 28px;border-right:1px solid var(--line);text-align:center">
        <span class="display" style="font-size:clamp(36px,4vw,64px);color:var(--ink);display:block">1</span>
        <span style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-mute);margin-top:8px;display:block">Workshop</span>
      </div>
      <div style="padding:40px 28px;border-right:1px solid var(--line);text-align:center;background:var(--bg-2)">
        <span class="display" style="font-size:clamp(36px,4vw,64px);color:var(--ink);display:block">12</span>
        <span style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-mute);margin-top:8px;display:block">People</span>
      </div>
      <div style="padding:40px 28px;border-right:1px solid var(--line);text-align:center">
        <span class="display" style="font-size:clamp(36px,4vw,64px);color:var(--ink);display:block">500</span>
        <span style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-mute);margin-top:8px;display:block">Bags/Drop</span>
      </div>
      <div style="padding:40px 28px;text-align:center;background:var(--bg-2)">
        <span class="display" style="font-size:clamp(36px,4vw,64px);color:var(--orange);display:block">&infin;</span>
        <span style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-mute);margin-top:8px;display:block">Repair</span>
      </div>
    </div>

    {%- comment -%} MISSION {%- endcomment -%}
    <div style="border-top:1px solid var(--line);padding:56px 0;text-align:center;margin-bottom:72px">
      <span style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--ink-mute);display:block;margin-bottom:24px">// MISSION</span>
      <h2 class="display" style="font-size:clamp(40px,5vw,80px);margin:0 0 24px">One product.<br>One promise.</h2>
      <p style="font-size:17px;line-height:1.7;color:var(--ink-dim);max-width:560px;margin:0 auto">
        We make one thing &mdash; a backpack &mdash; and we make it better than anyone. No hoodies, no hats, no lifestyle empire. Just the bag. Forever repairable, endlessly customizable, built to last decades.
      </p>
    </div>

    {%- comment -%} TIMELINE {%- endcomment -%}
    <div style="border-top:1px solid var(--line);padding-top:56px;margin-bottom:72px">
      <span style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--ink-mute);display:block;margin-bottom:40px">// TIMELINE / 2026</span>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:0" class="about-timeline-grid">
        <div style="padding:28px;border:1px solid var(--line);border-right:0">
          <span class="display" style="font-size:28px;color:var(--orange);display:block;margin-bottom:12px">Q1</span>
          <span style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink);display:block;margin-bottom:8px">Idea</span>
          <p style="font-size:14px;color:var(--ink-dim);line-height:1.6">Concept born. First sketches on the back of a receipt.</p>
        </div>
        <div style="padding:28px;border:1px solid var(--line);border-right:0;background:var(--bg-2)">
          <span class="display" style="font-size:28px;color:var(--orange);display:block;margin-bottom:12px">Q2</span>
          <span style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink);display:block;margin-bottom:8px">First Prototype</span>
          <p style="font-size:14px;color:var(--ink-dim);line-height:1.6">SwitchPanel system validated. Material sourcing locked.</p>
        </div>
        <div style="padding:28px;border:1px solid var(--line);border-right:0">
          <span class="display" style="font-size:28px;color:var(--orange);display:block;margin-bottom:12px">Q3</span>
          <span style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink);display:block;margin-bottom:8px">Drop 0 (Beta)</span>
          <p style="font-size:14px;color:var(--ink-dim);line-height:1.6">97 bags. 87 testers. 11 cities. Real-world feedback loop.</p>
        </div>
        <div style="padding:28px;border:1px solid var(--line);background:var(--bg-2)">
          <span class="display" style="font-size:28px;color:var(--orange);display:block;margin-bottom:12px">Q4</span>
          <span style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink);display:block;margin-bottom:8px">Drop 01</span>
          <p style="font-size:14px;color:var(--ink-dim);line-height:1.6">500 units. Production run. The real thing.</p>
        </div>
      </div>
    </div>

    {%- comment -%} CTA {%- endcomment -%}
    <div style="text-align:center;padding:40px 0">
      <a href="/collections/all" class="btn primary">Shop Drop 01 <span class="arr">&rarr;</span></a>
    </div>

  </div>
</section>

<style>
  @media(max-width:768px){
    .about-story-grid{grid-template-columns:1fr !important}
    .about-stats-grid{grid-template-columns:repeat(2,1fr) !important}
    .about-stats-grid > div:nth-child(2){border-right:0 !important}
    .about-timeline-grid{grid-template-columns:1fr !important}
    .about-timeline-grid > div{border-right:1px solid var(--line) !important}
  }
</style>

{% schema %}
{
  "name": "About Page",
  "settings": []
}
{% endschema %}
